{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": { "@shared/*": ["../../src/shared/*"], "@herald/*": ["./src/common/*"], "@launcher/*": ["../../src/renderer/src/*"], "@locales/*": ["../../locales/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/common/**/*"]
}
