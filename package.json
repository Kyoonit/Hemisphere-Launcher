{
  "name": "hemisphere-launcher",
  "productName": "Hemisphere Launcher",
  "version": "1.0.16",
  "description": "The official launcher for Hemisphere SMP",
  "author": "Hemisphere SMP",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "i18n:check": "node tools/i18n-check.mjs",
    "postinstall": "node node_modules/electron/install.js",
    "test": "vitest run",
    "content:keygen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/content/keygen.ts",
    "content:publish": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/content/publish.ts",
    "content:feed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/content/feed.ts",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "node tools/release-notes.mjs && npm run build && electron-builder --win --publish always -c.releaseInfo.releaseNotesFile=dist/release-notes.md",
    "staff-code": "node tools/staff-code.mjs"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "electron-updater": "6.8.9",
    "i18next": "26.4.2",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "overrides": {
    "undici": "7.30.0"
  }
}
