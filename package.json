{
  "name": "hemisphere-launcher",
  "productName": "Hemisphere Launcher",
  "version": "1.4.1",
  "description": "The official launcher for Hemisphere SMP",
  "author": "Hemisphere SMP",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "i18n:check": "node tools/i18n-check.mjs",
    "postinstall": "node node_modules/electron/install.js",
    "test": "vitest run",
    "content:keygen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/content/keygen.ts",
    "content:publish": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/content/publish.ts",
    "content:feed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/content/feed.ts",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "node tools/release.mjs",
    "release:minor": "node tools/release.mjs --minor",
    "release:fix": "node tools/release.mjs --fix",
    "staff-code": "node tools/staff-code.mjs",
    "herald:test-key": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/herald/test-key.ts",
    "herald:github-app": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/herald/github-app.ts",
    "herald:import-v1": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/herald/import-v1.ts",
    "herald:production": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/herald/production-setup.ts",
    "herald:server:dev": "wrangler dev --config herald/server/wrangler.toml --local --port 8787 --test-scheduled --var HERALD_ENV:local",
    "herald:server:migrate": "wrangler d1 migrations apply herald-staging --config herald/server/wrangler.toml --local",
    "herald:server:types": "wrangler types --config herald/server/wrangler.toml herald/server/worker-configuration.d.ts",
    "herald:server:typecheck": "tsc --noEmit -p herald/server/tsconfig.json",
    "herald:server:deploy": "wrangler deploy --config herald/server/wrangler.toml",
    "herald:publisher:build": "esbuild tools/herald/publish-run.ts --bundle --platform=node --format=esm --target=node20 --legal-comments=none --outfile=herald/publisher/dist/herald-publish.mjs",
    "herald:e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/herald/e2e.ts",
    "herald:e2e-v2": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/herald/e2e-v2.ts",
    "herald:e2e-accounts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/herald/e2e-accounts.ts",
    "herald:server:reset-local": "wrangler d1 execute herald-staging --config herald/server/wrangler.toml --local --command \"DELETE FROM sessions; DELETE FROM activity; DELETE FROM profiles; DELETE FROM publications; DELETE FROM publication_versions; DELETE FROM comments; DELETE FROM settings; DELETE FROM settings_versions;\"",
    "herald:e2e-publications": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/herald/e2e-publications.ts",
    "herald:e2e-server": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/herald/e2e-server.ts",
    "herald:build": "electron-vite build --config herald/app/electron.vite.config.ts",
    "herald:typecheck": "tsc -p herald/app/tsconfig.node.json && tsc -p herald/app/tsconfig.web.json",
    "herald:dist": "npm run herald:typecheck && npm run herald:build && electron-builder --projectDir herald/app --win --publish never",
    "herald:backup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning tools/herald/backup.ts",
    "herald:release": "node tools/herald/release.mjs",
    "herald:release:minor": "node tools/herald/release.mjs --minor"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "electron-updater": "6.8.9",
    "i18next": "26.4.2",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "skinview3d": "3.4.2",
    "three": "0.156.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "wrangler": "4.139.0"
  },
  "overrides": {
    "undici": "7.30.0"
  }
}
